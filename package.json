{
  "name": "kebena-mkc-display",
  "version": "1.0.2",
  "description": "Kebena MKC Church TV display app: song lyrics, weekly notices, bank accounts",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.kebena.display",
    "productName": "Kebena MKC Church Display",
    "asar": true,
    "files": [
      "**/*",
      "!dist/*",
      "!node_modules/.cache/*",
      "!generate-icon.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Hakevesc",
        "repo": "kmkc",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "identity": null,
      "artifactName": "KebenaMKCChurchDisplay-mac-${version}-${arch}.${ext}"
    },
    "artifactName": "KebenaMKCChurchDisplay-Setup-${version}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mammoth": "^1.7.0",
    "puppeteer": "^22.15.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  }
}
