{
  "name": "kebena-mkc-display",
  "version": "1.0.0",
  "description": "Kebena MKC Church TV display app: song lyrics, weekly notices, bank accounts",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.kebena.display",
    "productName": "Kebena MKC Church Display",
    "asar": true,
    "files": [
      "**/*",
      "!dist/*",
      "!node_modules/.cache/*",
      "!generate-icon.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "mammoth": "^1.7.0",
    "puppeteer": "^22.15.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  }
}
